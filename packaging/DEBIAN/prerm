#!/bin/sh
set -e
if [ "$1" = remove ] || [ "$1" = deconfigure ]; then
    # Stop the units in every running user manager, respecting policy-rc.d.
    # Do not stop during upgrade: postinst reloads and restarts the new code.
    if command -v deb-systemd-invoke >/dev/null 2>&1; then
        deb-systemd-invoke --user stop wayvoice.service wayvoice-engine-setup.service wayvoice-setup.service wayvoice-ydotool.service >/dev/null 2>&1 || true
    fi
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --global disable wayvoice.service wayvoice-setup.service wayvoice-ydotool.service >/dev/null 2>&1 || true
    fi
fi
exit 0
